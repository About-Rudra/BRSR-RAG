# Copy to .env (never commit .env). In Colab, put keys in Colab Secrets instead.

# --- LLM (baseline and agent always share these) ---
LLM_PROVIDER=gemini            # gemini | groq | ollama
LLM_MODEL=gemini-3.1-flash-lite  # free tier friendly; gemini-3.6-flash allows only 20 requests/day free. groq: llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
# LLM_RPM=10                   # client-side requests/minute cap; default 10 for gemini, 30 for groq
GOOGLE_API_KEY=your-google-api-key-here
GROQ_API_KEY=your-groq-api-key-here
# OLLAMA_URL=http://localhost:11434   # only if LLM_PROVIDER=ollama

# --- Vector DB ---
QDRANT_MODE=local              # local (embedded, no server) | server | cloud
QDRANT_PATH=vector_db
# QDRANT_URL=https://<cluster>.cloud.qdrant.io:6333   # only if QDRANT_MODE=cloud
# QDRANT_API_KEY=your-qdrant-cloud-key
# QDRANT_HOST=localhost        # only if QDRANT_MODE=server
# QDRANT_PORT=6333

# --- Ingestion ---
INGEST_MODE=sync               # sync | redis
# REDIS_HOST=localhost         # only if INGEST_MODE=redis
# REDIS_PORT=6379

# --- Baseline chatbot ---
TOP_K_CONTEXT=4

# --- Streamlit app (optional) ---
# APP_PASSWORD=choose-a-password   # gate the public link so it cannot use up your API quota
